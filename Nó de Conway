vincularCombate (No _ _ NotSlice) = 
    "Complexidade detectada: Samanta (Fukua) deve processar via Simulacro."
vincularCombate (No _ _ Slice) = 
    "Estabilidade garantida: Theodore (Beowulf) pode executar o Actus."

-- --- EXECUÇÃO DO LOGOS ---
