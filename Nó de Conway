} deriving (Show)

-- | Classe para transformações de Lisa Piccirillo
-- 'Inter-legere': A capacidade de ler a estrutura oculta
class Topologia a where
    verificarFatiado :: a -> Bool
    gerarNoTraco     :: a -> a

instance Topologia MatematicaNo where
    -- O Nó de Conway (YD154236546BR) não é fatiado (NotSlice)
    verificarFatiado no = estado no == Slice

    -- A técnica de Piccirillo: substituir o nó por um "irmão" (Trace)
    -- que compartilha o mesmo "traço" quadridimensional
    gerarNoTraco (No "Conway" c _) = No "Piccirillo_Trace" c NotSlice
    gerarNoTraco no = no

-- | Sincronização com os Simulacros de Samanta e Theodore
-- Onde a topologia encontra o Skullgirls.apk
